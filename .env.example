# Server-only settings: NEVER prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback campaign slug, which must exist in campaign_partners.
# Most operators should use links with ?p=their-assigned-slug.
DEFAULT_PARTNER_SLUG=

# Comma-separated exact origins allowed to submit leads. Replace with the deployed origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port for the Express API and production server.
PORT=3001
